{
  "name": "Meu Fluxo",
  "steps": [
    {
      "action": "extract",
      "selector": "#root > div.flex.h-screen.overflow-hidden.bg-background > div.flex-1.flex.flex-col.min-w-0.overflow-hidden > main > div > div > div > div.flex-1.flex.flex-col.min-w-0 > div.flex-1.overflow-y-auto.px-4.py-3.space-y-4",
      "variable": "chat"
    },
    {
      "action": "wait",
      "seconds": 5
    },
    {
      "action": "loop",
      "times": 2,
      "interval": 5,
      "steps": [
        {
          "action": "extract",
          "selector": "#root > div.flex.h-screen.overflow-hidden.bg-background > div.flex-1.flex.flex-col.min-w-0.overflow-hidden > main > div > div > div > div.flex-1.flex.flex-col.min-w-0 > div.flex-1.overflow-y-auto.px-4.py-3.space-y-4",
          "variable": "chat2"
        },
        {
          "action": "compare",
          "var": "chat2",
          "value": "{chat}",
          "on_true": [
            {
              "action": "log",
              "message": "igual"
            }
          ],
          "on_false": [
            {
              "action": "log",
              "message": "difere"
            }
          ]
        }
      ]
    }
  ]
}